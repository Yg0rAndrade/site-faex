{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-faex",
  "compatibility_date": "2026-11-01",
  // Gera o dist/ antes de publicar (o `wrangler deploy` roda este comando primeiro).
  "build": {
    "command": "npm run build"
  },
  // Site estático do Astro: o `npm run build` gera a pasta dist/, servida como assets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
