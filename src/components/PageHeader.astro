---
interface Props { title: string; subtitle?: string; eyebrow?: string }
const { title, subtitle, eyebrow } = Astro.props;
---

<section class="bg-gradient-to-br from-faex-navy-dark to-faex-navy py-16 text-white">
  <div data-reveal class="mx-auto max-w-7xl px-4">
    {eyebrow && <span class="font-semibold uppercase tracking-wide text-faex-orange">{eyebrow}</span>}
    <h1 class="mt-2 text-4xl font-extrabold md:text-5xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-lg text-white/80">{subtitle}</p>}
  </div>
</section>
