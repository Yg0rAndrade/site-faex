---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import noticias from '../data/noticias.json';

const fmt = (d: string) => new Date(d.replace(' ', 'T')).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
---

<Layout title="Notícias">
  <PageHeader eyebrow="Fique por dentro" title="Notícias" />
  <section class="mx-auto max-w-7xl px-4 py-14">
    <div data-reveal="stagger" class="grid gap-6 md:grid-cols-2">
      {noticias.map((n) => (
        <article class="overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-slate-200">
          <img src={n.imagem_url} alt="" loading="lazy" class="aspect-video w-full object-cover" />
          <div class="p-6">
            <time class="text-xs font-semibold uppercase text-faex-orange-dark">{fmt(n.created_date)}</time>
            <h2 class="mt-1 text-xl font-bold text-faex-navy">{n.titulo}</h2>
            <p class="mt-2 text-slate-600">{n.resumo}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
