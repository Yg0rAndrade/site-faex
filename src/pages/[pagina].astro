---
// Páginas ainda não construídas: mostram um aviso "em construção" para o menu funcionar.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { placeholderPages } from '../data/site';

export function getStaticPaths() {
  return Object.entries(placeholderPages).map(([pagina, title]) => ({ params: { pagina }, props: { title } }));
}

const { title } = Astro.props;
---

<Layout title={title}>
  <PageHeader title={title} />
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p data-reveal class="text-lg text-slate-500">Página em construção. Conteúdo será migrado do site original.</p>
  </section>
</Layout>
