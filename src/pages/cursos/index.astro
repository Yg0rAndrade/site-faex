---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CourseCard from '../../components/CourseCard.astro';
import cursos from '../../data/cursos.json';
import { courseCategories } from '../../data/site';

const groups = courseCategories
  .map((c) => ({ ...c, items: cursos.filter((x) => x.tipo === c.tipo && x.ofertando).sort((a, b) => a.ordem - b.ordem) }))
  .filter((g) => g.items.length > 0);
---

<Layout title="Cursos">
  <PageHeader eyebrow="Cursos" title="Todos os cursos" subtitle="Graduação, Pós-Graduação, Técnico e Formação Continuada reconhecidos pelo MEC." />
  {groups.map((g) => (
    <section class="mx-auto max-w-7xl px-4 py-14">
      <div data-reveal class="mb-8 flex items-end justify-between">
        <h2 class="text-3xl font-extrabold text-faex-navy">{g.label}</h2>
        <a href={`/cursos/${g.slug}`} class="font-semibold text-faex-blue hover:underline">Ver todos →</a>
      </div>
      <div data-reveal="stagger" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {g.items.map((c) => <CourseCard course={c} />)}
      </div>
    </section>
  ))}
</Layout>
