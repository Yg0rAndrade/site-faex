---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CourseCard from '../../components/CourseCard.astro';
import cursos from '../../data/cursos.json';
import { courseCategories } from '../../data/site';

export function getStaticPaths() {
  return courseCategories.map((c) => ({ params: { categoria: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const items = cursos.filter((c) => c.tipo === category.tipo && c.ofertando).sort((a, b) => a.ordem - b.ordem);
---

<Layout title={`Cursos de ${category.label}`}>
  <PageHeader eyebrow="Cursos" title={category.label} />
  <section class="mx-auto max-w-7xl px-4 py-14">
    {items.length > 0 ? (
      <div data-reveal="stagger" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((c) => <CourseCard course={c} />)}
      </div>
    ) : (
      <p class="text-center text-lg text-slate-500">Nenhum curso com inscrições abertas nesta categoria no momento.</p>
    )}
  </section>
</Layout>
